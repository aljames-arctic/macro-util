{
  "id": "macro-util",
  "title": "Macro Utility!? Bakana!",
  "version": "2.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13",
    "maximum": "13"
  },
  "description": "<p>A growing collection of macros and macro utility functions for use with Midi-QOL.</p>",
  "authors": [
    {
      "name": "Bakana Baka",
      "discord": "bakanabaka",
      "flags": {}
    }
  ],
  "esmodules": [
    "src/module.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "settings": [
    {
      "key": "llmProvider",
      "name": "LLM Provider",
      "hint": "The LLM provider to use.",
      "scope": "world",
      "config": true,
      "type": "String",
      "choices": {
        "gemini": "Gemini",
        "openai": "OpenAI"
      },
      "default": "gemini"
    },
    {
      "key": "llmApiKey",
      "name": "LLM API Key",
      "hint": "The API key for the selected LLM provider.",
      "scope": "world",
      "config": true,
      "type": "String",
      "default": ""
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "bugs": "https://github.com/aljames-arctic/macro-util/issues",
  "license": "LICENSE",
  "readme": "README.md",
  "media": [
    {
      "type": "icon",
      "loop": false,
      "flags": {}
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "midi-qol",
        "type": "module",
        "compatibility": {}
      }
    ]
  },
  "flags": {}
}